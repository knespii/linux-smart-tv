[Unit]
Description=Smart TV (Home button -> YouTube / Netflix / Steam / Heroic / Discord / Home Assistant)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# In the "Smart TV" login session the kiosk script runs the home screen itself.
ExecCondition=/bin/sh -c '! pgrep -u "$(id -u)" -x gnome-kiosk >/dev/null'
ExecStart=/usr/bin/python3 %h/.local/share/smart-tv/smart_tv.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
